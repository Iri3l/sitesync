// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sites         Site[]    @relation("SiteManager")
  siteDiaries   SiteDiary[]
  snags         Snag[]    @relation("SnagCreator")
  snagsAssigned Snag[]    @relation("SnagAssignee")
  stockTransactions StockTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id          String      @id @default(cuid())
  name        String
  address     String?
  status      String      @default("active")
  managerId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  manager     User        @relation("SiteManager", fields: [managerId], references: [id])
  siteDiaries SiteDiary[]
  snags       Snag[]
  stockItems  StockItem[]
}

model SiteDiary {
  id          String        @id @default(cuid())
  siteId      String
  userId      String
  date        DateTime      @default(now())
  weather     String?
  workers     Int?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  photos      DiaryPhoto[]
}

model DiaryPhoto {
  id          String    @id @default(cuid())
  diaryId     String
  url         String
  caption     String?
  createdAt   DateTime  @default(now())

  diary       SiteDiary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
}

model Snag {
  id          String      @id @default(cuid())
  siteId      String
  createdById String
  assignedToId String?
  title       String
  description String?     @db.Text
  location    String?
  status      String      @default("open") // open, in_progress, resolved
  priority    String      @default("medium") // low, medium, high, critical
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  resolvedAt  DateTime?

  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("SnagCreator", fields: [createdById], references: [id])
  assignedTo User?        @relation("SnagAssignee", fields: [assignedToId], references: [id])
  photos      SnagPhoto[]
}

model SnagPhoto {
  id          String    @id @default(cuid())
  snagId      String
  url         String
  caption     String?
  createdAt   DateTime  @default(now())

  snag        Snag      @relation(fields: [snagId], references: [id], onDelete: Cascade)
}

model StockItem {
  id          String            @id @default(cuid())
  siteId      String
  name        String
  category    String?
  unit        String            @default("pcs") // pcs, m2, m3, kg, etc.
  quantity    Float             @default(0)
  minQuantity Float?            @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  transactions StockTransaction[]
}

model StockTransaction {
  id          String      @id @default(cuid())
  stockItemId String
  userId      String
  type        String      // "in" or "out"
  quantity    Float
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())

  stockItem   StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
}

